{
  "name": "predictor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "validate:env": "tsx scripts/validate-env.ts",
    "build": "npm run validate:env && next build",
    "start": "next start",
    "lint": "eslint src scripts e2e playwright.config.ts vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:preview": "tsx scripts/run-e2e.ts --external-smoke",
    "test:e2e:run": "tsx scripts/run-e2e.ts --skip-build",
    "test:client-secrets": "tsx scripts/run-e2e.ts --client-secret-check-only",
    "test:client-secrets:scan": "tsx scripts/check-client-secret-absence.ts",
    "preview:local": "tsx scripts/run-e2e.ts --skip-build --serve-only",
    "types:db": "supabase gen types typescript --local > src/types/database.generated.ts",
    "types:check": "tsx scripts/check-database-types.ts",
    "docs:book": "python scripts/generate-project-book.py",
    "docs:book:check": "python scripts/generate-project-book.py --check",
    "docs:submission:check": "node scripts/check-submission-docs.mjs",
    "submission:evidence:check": "node scripts/check-final-submission-evidence.mjs",
    "presentation:build": "node scripts/generate-presentation.mjs",
    "presentation:build:check": "node scripts/generate-presentation.mjs --check",
    "presentation:check": "node scripts/check-presentation-artifacts.mjs",
    "hardening:check": "node scripts/check-final-hardening.mjs",
    "owner-runbooks:check": "node scripts/check-slice9-owner-runbooks.mjs",
    "scale:plans": "tsx scripts/check-scale-plans.ts",
    "sports:secret-boundaries": "node scripts/check-sports-secret-boundaries.mjs",
    "poc:sports": "tsx scripts/sports-provider-poc.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run submission:evidence:check && npm run hardening:check && npm run owner-runbooks:check && npm run sports:secret-boundaries && npm run test:db && npm run scale:plans && npm run types:check && npm run docs:book:check && npm run docs:submission:check && npm run presentation:check && npm run test:client-secrets && npm run test:client-secrets:scan && npm run test:e2e:run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.49.1",
    "file-type": "^22.0.1",
    "next": "16.4.0-canary.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/env": "16.4.0-canary.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0-canary.9",
    "supabase": "2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
