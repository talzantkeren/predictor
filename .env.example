NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for the fixed payment-proofs Storage gateway; never expose or commit a value.
SUPABASE_SECRET_KEY=
# Optional until the Slice 7 Cron route exists.
CRON_SECRET=
# Server-only UUID of the dedicated non-interactive system_admins principal; required by Slice 7.
SYNC_SYSTEM_ACTOR_ID=
SPORTS_API_PROVIDER=manual
# Required only when SPORTS_API_PROVIDER=api.
SPORTS_API_KEY=
# Reserved for the later AI slice; leave empty in Slice 0.
AI_API_KEY=
AI_MODEL=
DEMO_MODE=true
