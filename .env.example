NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for the fixed payment-proofs Storage gateway; never expose or commit a value.
SUPABASE_SECRET_KEY=
# Server-only. Required only when the Slice 7 Cron route is invoked; store the deployed copy in Vault too.
CRON_SECRET=
# Server-only UUID of the dedicated non-interactive system_admins principal; required at Cron runtime.
SYNC_SYSTEM_ACTOR_ID=
SPORTS_API_PROVIDER=manual
# Server-only. Required only when SPORTS_API_PROVIDER=api-football; keep empty for manual and never expose it.
SPORTS_API_KEY=
DEMO_MODE=true
